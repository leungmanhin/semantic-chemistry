; ===========================================================================
; ACS — P2 mortal-ACS detection (TECAN T3 / Alg 5.5 step 2 / MSC eq 18-19): mine the
; reaction graph from the event log + rule IR, discover the food-generated reflexively-
; autocatalytic loop A = (M_A, R_A), certify its §4.5 conditions, and emit the §2.9 verdicts —
; both M_A (the cycle's motif species) and R_A (the rules), plus closure + autocatalysis
; (structural, cond 1-2), metabolic surplus + causal influence (cond 3-4), and RECURRENCE over
; the cycle-tagged event log (one epoch = a structural candidate); heritability is P3. Each
; condition is its OWN verdict fact — there is no single "promoted/certified" summary; a
; consumer conjoins them (closure present ∧ surplus>0 ∧ causal ∧ recurrent ∧ …).
; Also hosts the acs-scan WORKER body (`run-as`) — the SAME certification run as a §6.4 worker
; kind, in isolated spaces (dispatched by `dispatch.metta`).
; ---------------------------------------------------------------------------
; The reaction graph is keyed on the graph-MOTIF — a rule's whole reactant/product PATTERN
; (a list of sem-edge clauses, jointly canonicalized so shared variables are kept), NOT a bare
; relation. Product-feeds-reactant is decided by UNIFICATION (a common instance), so a specific
; product meets a general premise (subsumption) and a single edge feeds a multi-edge premise
; ("products feed motifs that return to M_A within bounded steps"). STRUCTURAL CLOSURE
; (§4.5 cond 1) is ENDOGENOUS: a member set is structurally closed iff every member both lies on
; a member-to-member feeds-cycle AND has its whole non-food premise injectively regenerated by
; member products; the closure is then classified substrate / control / hybrid by the motifs it
; regenerates (semantic vs `(control-relation R)`). The evaluator's minting edge is FOOD (external
; reward), NOT closure, so the soma's feed-forward cue-converters — and a contracting self-loop
; like {R_trans} (two ReasonFor in, one out) — leave V3 with NO acs-closure fact: a subsidized
; candidate (viable+useful, but not a closed ACS; its subsidy is read off as surplus-but-no-
; closure). Membership (the food-fed reaction network) + closure are clamp-INDEPENDENT (the
; graph uses every mintable token); the clamp-switch shows in the componentwise metabolic surplus
; (eq 19) — a member's token whose income < spend fails condition 3 under that clamp (the SAME
; loop is viable under one clamp, starves under another). The food set is the parser's cues AND
; the minting reward (a
; rule whose input is never rule-produced, or is funded only by external reward, eats food).
; Condition 4 (causal influence) is a REPLAY ablation: re-derive the chamber's answers in a
; caller-bound ISOLATED space with the ACS members suppressed; if the answer count drops
; below the baseline, the loop causally produces those answers. Assumes util + fuel +
; compiler + reaction + grounder + evaluator + epoch + worker loaded (epoch supplies the
; set-cycle/refresh-pool the multi-task do-influence replay runs on); the event log + derived layer
; of one chamber run supply the log + income (the log reads take the run space $ws — &self on
; a bare run, the worker's own space via `run-as`, which CONSUMES the log a prior context-
; chamber worker left there rather than re-deriving — MSC §6.4 P2 "scan event logs"); the
; worker envelope's `copy-molecules`/`restore-snapshot` set up the ablation replay space.
; ===========================================================================

; --- reachability on a (medge Src Dst) graph (visited set; terminates on cycles) ---

; the direct successors / predecessors of $node
(= (succs $g $node) (collapse (match $g (medge $node $t) $t)))
(= (preds $g $node) (collapse (match $g (medge $s $node) $s)))

; BFS: does any node in $frontier reach $goal? ($seen guards against cycles)
(= (any-reaches $g $frontier $goal $seen)
   (case $frontier
         ((() False)
          ($ne (let $h (car-atom $frontier)
                    (if (== $h $goal)
                        True
                        (if (in-list? $h $seen)
                            (any-reaches $g (cdr-atom $frontier) $goal $seen)
                            (any-reaches $g (concat-lists (succs $g $h) (cdr-atom $frontier)) $goal (cons-atom $h $seen)))))))))

; does $node sit on a cycle (reach itself)?
(= (cycle-through $g $node) (any-reaches $g (succs $g $node) $node ()))

; --- MOTIF extraction + matching: the reaction graph is keyed on the graph-MOTIF (§4.5 M_A),
; and a motif is a graph PATTERN — a LIST of sem-edge clauses `(Rel arg…)` with the graph +
; edge-id bookkeeping stripped and the (var …) slots renamed to positional `(mvar N)` (jointly
; across the whole motif, so shared variables — the links between clauses — are preserved, and
; recursively, so nested compound args canonicalize too). A rule's reactant motif is its whole
; LHS (G1), its product motif its whole RHS (G2); so a multi-edge premise like a causal chain
; is ONE composite motif, not decomposed. Whether a product feeds a reactant is decided by
; UNIFICATION (a common instance) — which handles a specific product meeting a more-general
; premise (subsumption) and nested compound arguments, up to variable renaming. ---

; the first-occurrence index of $x in $l (or its length if absent — the index it would take)
(= (idx-of $x $l) (idx-of-from $x $l 0))
(= (idx-of-from $x $l $i)
   (case $l ((() $i) ($ne (if (== (car-atom $l) $x) $i (idx-of-from $x (cdr-atom $l) (+ $i 1)))))))

; append $x to $l iff not already present (the ordered set of vars seen so far)
(= (append-if-new $x $l) (if (in-list? $x $l) $l (concat-lists $l (cons-atom $x ()))))

; --- CANONICALIZE: collect the (var …) slots jointly (first-occurrence order), then replace
; each with (mvar <its index>); both passes recurse into nested compound arguments ---
(= (collect-vars $t $acc)
   (case $t (((var $v) (append-if-new $t $acc))
            ($o (if (== (get-metatype $t) Expression) (collect-vars-list $t $acc) $acc)))))
(= (collect-vars-list $t $acc)
   (if (== $t ()) $acc (collect-vars-list (cdr-atom $t) (collect-vars (car-atom $t) $acc))))
(= (subst-vars $t $vars)
   (case $t (((var $v) (mvar (idx-of $t $vars)))
            ($o (if (== (get-metatype $t) Expression) (subst-vars-list $t $vars) $t)))))
(= (subst-vars-list $t $vars)
   (if (== $t ()) () (cons-atom (subst-vars (car-atom $t) $vars) (subst-vars-list (cdr-atom $t) $vars))))

; the raw (Rel arg…) of one clause (graph + id stripped); `(at SPACE PAT)` unwraps; a non-sem-
; edge clause (e.g. sem-edge-tv) or a (var …) wildcard relation names no motif → nomotif
(= (mk-raw $r $args) (if (== (get-metatype $r) Symbol) (cons-atom $r $args) nomotif))
(= (clause-head-args $c)
   (case $c
         (((at $sp $pat) (clause-head-args $pat))
          ((sem-edge $g $id $r $a) (mk-raw $r (cons-atom $a ())))
          ((sem-edge $g $id $r $a $b) (mk-raw $r (cons-atom $a (cons-atom $b ()))))
          ((sem-edge $g $id $r $a $b $d) (mk-raw $r (cons-atom $a (cons-atom $b (cons-atom $d ())))))
          ($other nomotif))))
(= (raw-clauses $clauses)
   (if (== $clauses ()) ()
       (let $m (clause-head-args (car-atom $clauses))
            (if (== $m nomotif) (raw-clauses (cdr-atom $clauses)) (cons-atom $m (raw-clauses (cdr-atom $clauses)))))))

; THE composite motif of a clause list: its sem-edge clauses, jointly canonicalized
(= (canon-motif $clauses) (let $raw (raw-clauses $clauses) (subst-vars-list $raw (collect-vars-list $raw ()))))

; the reactant motif (whole LHS / G1) and product motif (whole RHS / G2) of rule $r
(= (rule-reactant $r) (canon-motif (match &self (rule-lhs $r $cs) $cs)))
(= (rule-product $r) (canon-motif (match &self (rule-rhs $r $ps) $ps)))

; --- UNIFICATION: do two clause patterns have a common instance? Their (mvar N) slots are
; independent, so tag one side `(lv N)` and the other `(rv N)` before unifying over a binding
; environment (assoc list); recurses structurally, so nested compounds are handled. ---
(= (uvar? $t) (case $t (((lv $n) True) ((rv $n) True) ($o False))))
(= (tag-side $side $t)
   (case $t (((mvar $n) ($side $n)) ($o (if (== (get-metatype $t) Expression) (tag-list $side $t) $t)))))
(= (tag-list $side $t) (if (== $t ()) () (cons-atom (tag-side $side (car-atom $t)) (tag-list $side (cdr-atom $t)))))
(= (lookup $t $env)
   (case $env ((() notfound) ($ne (let ($k $v) (car-atom $env) (if (== $k $t) $v (lookup $t (cdr-atom $env))))))))
(= (u-walk $t $env) (if (uvar? $t) (let $r (lookup $t $env) (if (== $r notfound) $t (u-walk $r $env))) $t))
(= (occurs? $var $t $env)
   (let $w (u-walk $t $env) (if (== $w $var) True (if (== (get-metatype $w) Expression) (occurs-list? $var $w $env) False))))
(= (occurs-list? $var $t $env)
   (if (== $t ()) False (if (occurs? $var (car-atom $t) $env) True (occurs-list? $var (cdr-atom $t) $env))))
(= (bind $var $val $env) (if (occurs? $var $val $env) fail (cons-atom ($var $val) $env)))
(= (unify $a $b $env)
   (if (== $env fail) fail
       (let $wa (u-walk $a $env)
            (let $wb (u-walk $b $env)
                 (if (== $wa $wb) $env
                     (if (uvar? $wa) (bind $wa $wb $env)
                         (if (uvar? $wb) (bind $wb $wa $env)
                             (if (== (get-metatype $wa) Expression)
                                 (if (== (get-metatype $wb) Expression) (unify-lists $wa $wb $env) fail) fail))))))))
(= (unify-lists $a $b $env)
   (if (== $a ()) (if (== $b ()) $env fail)
       (if (== $b ()) fail (unify-lists (cdr-atom $a) (cdr-atom $b) (unify (car-atom $a) (car-atom $b) $env)))))
(= (clauses-unify? $p1 $p2) (if (== (unify (tag-side lv $p1) (tag-side rv $p2) ()) fail) False True))

; does product motif $P feed reactant motif $Q — supply (unify with) one of $Q's clauses?
(= (clause-unifies-any $p $Q) (if (== $Q ()) False (if (clauses-unify? $p (car-atom $Q)) True (clause-unifies-any $p (cdr-atom $Q)))))
(= (motif-feeds? $P $Q) (if (== $P ()) False (if (clause-unifies-any (car-atom $P) $Q) True (motif-feeds? (cdr-atom $P) $Q))))

; INJECTIVE COVER: can every clause of $premise be matched to a DISTINCT clause of $products
; under unification? Each premise clause needs its OWN producer — two clauses of one motif are
; NOT both met by a single producer that makes one, which is what fails a contracting self-loop
; ({R_trans}: two ReasonFor in, one out) while admitting a genuine ring (each 1-clause premise
; met by a distinct producer) and Ben's balanced singleton. Backtracking; food clauses are
; filtered out before this is called.
(= (injective-cover? $premise $products)
   (if (== $premise ()) True
       (try-cover (car-atom $premise) (cdr-atom $premise) $products $products)))
(= (try-cover $p $rest $products $pool)
   (case $pool
         ((() False)
          ($ne (let $q (car-atom $pool)
                    (if (clauses-unify? $p $q)
                        (if (injective-cover? $rest (remove-one $q $products)) True (try-cover $p $rest $products (cdr-atom $pool)))
                        (try-cover $p $rest $products (cdr-atom $pool))))))))

; --- the fired rules + firing counts (from the cycle-tagged event log in run space $ws).
; fired-rules spans the WHOLE log (structure / membership); rule-firings counts the cycles of
; the POSED TASK — eq-19 surplus is measured per task, since a task's income arrives when its
; questions are answered and its spend is whatever the cycles working it cost. A run that was
; never task-tagged falls back to the current cycle, which is what a bare run means. ---
(= (fired-rules $ws) (dedup (collapse (match $ws (event $c $s $r $k) $r))))

; the cycles the posed task's spend is measured over (the current cycle on an untagged run)
(= (spend-cycles $ws)
   (let $cs (cycles-of-task $ws (current-task $ws))
        (if (== $cs ()) (cons-atom (current-cycle $ws) ()) $cs)))

(= (rule-firings $ws $r) (firings-in-cycles $ws $r (spend-cycles $ws)))
(= (firings-in-cycles $ws $r $cs)
   (case $cs
         ((() 0)
          ($ne (let $c (car-atom $cs)
                    (+ (foldall + (match $ws (event $c $s $r $k) 1) 0)
                       (firings-in-cycles $ws $r (cdr-atom $cs))))))))

; --- the food-supply (external-reward) ingredients (clamp-independent, for membership) ---

; every token some clamp can mint (the evaluator's minting alphabet)
(= (mintable-tokens) (dedup (collapse (match &self (clamp-mint $cl $a $tok $n) $tok))))

; the rules that cost token $tok (the token funds them)
(= (rules-costing $tok) (dedup (collapse (match &self (rule-token-cost $r $tok $n) $r))))

; is graph $g an answer-skeleton?
(= (answer-skel? $g) (case (collapse (match &self (sem-graph-kind $g answer-skeleton) yes)) ((() False) ($x True))))

; the canonical single clauses appearing in answer-skeletons (the motifs answers query); a
; product motif answers a query iff one of its clauses unifies one of these
(= (canon1 $semedge) (let $m (canon-motif ($semedge)) (if (== $m ()) skip (car-atom $m))))
(= (answer-clauses)
   (dedup (filter-out skip
     (concat-lists (collapse (match &self (sem-edge $g $c $r $a) (if (answer-skel? $g) (canon1 (sem-edge $g $c $r $a)) skip)))
       (concat-lists (collapse (match &self (sem-edge $g $c $r $a $b) (if (answer-skel? $g) (canon1 (sem-edge $g $c $r $a $b)) skip)))
                     (collapse (match &self (sem-edge $g $c $r $a $b $d) (if (answer-skel? $g) (canon1 (sem-edge $g $c $r $a $b $d)) skip))))))))

; --- build the reaction graph in space $g: reactant→rule→product, product-feeds-reactant, +
; the food-supply edges ---

; add each medge in list $es to $g
(= (add-edges $g $es)
   (case $es
         ((() done)
          ($ne (let* (($h (car-atom $es)) ($z (add-atom $g $h))) (add-edges $g (cdr-atom $es)))))))

; each rule's two edges: reactant-motif → rule (consumes G1), rule → product-motif (makes G2)
(= (rule-edges $r) (cons-atom (medge (rule-reactant $r) $r) (cons-atom (medge $r (rule-product $r)) ())))
(= (rules-edges $rs) (case $rs ((() ()) ($ne (concat-lists (rule-edges (car-atom $rs)) (rules-edges (cdr-atom $rs)))))))

; the distinct reactant / product motifs of a rule list (a set — many rules may share a motif)
(= (all-reactants $rs) (dedup (reactants-of $rs)))
(= (reactants-of $rs) (case $rs ((() ()) ($ne (cons-atom (rule-reactant (car-atom $rs)) (reactants-of (cdr-atom $rs)))))))
(= (all-products $rs) (dedup (products-of $rs)))
(= (products-of $rs) (case $rs ((() ()) ($ne (cons-atom (rule-product (car-atom $rs)) (products-of (cdr-atom $rs)))))))

; feeds edges: product motif P → reactant motif Q wherever P supplies (unifies) one of Q's
; clauses — this is the doc's "products feed motifs that return to M_A within bounded steps",
; so a single ReasonFor product feeds the two-edge chain premise
(= (feeds-from $P $reactants)
   (case $reactants
         ((() ())
          ($ne (let $Q (car-atom $reactants)
                    (if (motif-feeds? $P $Q)
                        (cons-atom (medge $P $Q) (feeds-from $P (cdr-atom $reactants)))
                        (feeds-from $P (cdr-atom $reactants))))))))
(= (feeds-edges $products $reactants)
   (case $products
         ((() ())
          ($ne (concat-lists (feeds-from (car-atom $products) $reactants) (feeds-edges (cdr-atom $products) $reactants))))))

; the FOOD-supply edges: answer-motif → E, E → token, token → funded rule (an answer-motif is
; a product motif that feeds an answer-skeleton clause). The evaluator's external reward is
; FOOD — it lets the food-fed converters participate in the reaction NETWORK (so they count as
; members) but does NOT establish closure; closure is endogenous only (`structurally-closed?`).
(= (motif-E-edges $motifs) (if (== $motifs ()) () (cons-atom (medge (car-atom $motifs) E) (motif-E-edges (cdr-atom $motifs)))))
(= (E-tok-edges $toks) (if (== $toks ()) () (cons-atom (medge E (car-atom $toks)) (E-tok-edges (cdr-atom $toks)))))
(= (tok-fund-edges $tok $rs) (if (== $rs ()) () (cons-atom (medge $tok (car-atom $rs)) (tok-fund-edges $tok (cdr-atom $rs)))))
(= (toks-fund-edges $toks)
   (case $toks ((() ()) ($ne (concat-lists (tok-fund-edges (car-atom $toks) (rules-costing (car-atom $toks))) (toks-fund-edges (cdr-atom $toks)))))))
(= (queried-products $products)
   (case $products
         ((() ())
          ($ne (let $P (car-atom $products)
                    (if (motif-feeds? $P (answer-clauses))
                        (cons-atom $P (queried-products (cdr-atom $products)))
                        (queried-products (cdr-atom $products))))))))
(= (food-edges $rs)
   (concat-lists (motif-E-edges (queried-products (all-products $rs)))
                 (concat-lists (E-tok-edges (mintable-tokens)) (toks-fund-edges (mintable-tokens)))))

; build the whole reaction graph (rule edges + endogenous feeds + food-supply edges) into $g
(= (build-graph $g $rs)
   (add-edges $g (concat-lists (rules-edges $rs)
                   (concat-lists (feeds-edges (all-products $rs) (all-reactants $rs)) (food-edges $rs)))))

; --- MEMBERSHIP: the fired rules in the food-fed reaction network — each on a cycle in the
; FULL graph (endogenous feeds + food-supply edges). Food edges legitimately place the cue-
; converters in the network; whether the set is CLOSED is the separate endogenous question
; below. ---
(= (acs-members $g $rs)
   (case $rs
         ((() ())
          ($ne (let $r (car-atom $rs)
                    (if (cycle-through $g $r)
                        (cons-atom $r (acs-members $g (cdr-atom $rs)))
                        (acs-members $g (cdr-atom $rs))))))))

; --- STRUCTURAL CLOSURE (§4.5 cond 1, per Ben's ACS_notes): does the member SET regenerate its
; own non-food ingredients? Computed over the ENDOGENOUS feeds ONLY (member product motif unifies
; member reactant motif, `motif-feeds?`) — the evaluator's minting edge is FOOD, so it never
; closes the loop. A member is endo-cyclic iff its product reaches its own reactant through
; member-to-member feeds; the set is structurally closed iff EVERY member is endo-cyclic (a
; recurrent component over feeds-edges). A feed-forward food-converter (its reactant is a cue no
; rule regenerates) is on no such cycle, so a set containing one is `subsidized`, not closed. ---

; does member $a's product motif feed member $b's reactant motif (endogenous, by unification)?
(= (rule-feeds-rule? $a $b) (motif-feeds? (rule-product $a) (rule-reactant $b)))

; the members $a's product feeds (its endogenous successors within the set)
(= (feed-succs $a $members)
   (case $members
         ((() ())
          ($ne (let $b (car-atom $members)
                    (if (rule-feeds-rule? $a $b)
                        (cons-atom $b (feed-succs $a (cdr-atom $members)))
                        (feed-succs $a (cdr-atom $members))))))))

; BFS over member-to-member feeds: does any rule in $frontier reach $goal? ($seen guards cycles)
(= (rules-reach $members $frontier $goal $seen)
   (case $frontier
         ((() False)
          ($ne (let $h (car-atom $frontier)
                    (if (== $h $goal)
                        True
                        (if (in-list? $h $seen)
                            (rules-reach $members (cdr-atom $frontier) $goal $seen)
                            (rules-reach $members (concat-lists (feed-succs $h $members) (cdr-atom $frontier)) $goal (cons-atom $h $seen)))))))))

; is $r on an endogenous cycle within the set (its product feeds back to its own reactant)?
(= (endo-cyclic? $r $members) (rules-reach $members (feed-succs $r $members) $r ()))

; --- INJECTIVE non-food-premise COVERAGE: does the SET regenerate the whole of $r's premise?
; Per Ben's ACS_notes, closure needs "every non-food motif required to sustain its reactions
; produced by the set itself". A premise clause is FOOD iff no member produces it (a surface cue
; supplied externally) — exempt; a NON-FOOD clause (unifies some member product) must be covered,
; injectively (a distinct producer each). ---

; every product motif clause the member set supplies (the coverage pool)
(= (member-products $members)
   (case $members ((() ()) ($ne (concat-lists (rule-product (car-atom $members)) (member-products (cdr-atom $members)))))))

; $r's NON-FOOD premise clauses w.r.t. the supply $prods (a clause unifying no product is food)
(= (nonfood-premise $r $prods) (keep-unifying (rule-reactant $r) $prods))
(= (keep-unifying $clauses $prods)
   (case $clauses
         ((() ())
          ($ne (let $c (car-atom $clauses)
                    (if (clause-unifies-any $c $prods)
                        (cons-atom $c (keep-unifying (cdr-atom $clauses) $prods))
                        (keep-unifying (cdr-atom $clauses) $prods)))))))

; is $r's non-food premise injectively covered by the member products? (food clauses exempt)
(= (injective-covered? $r $members)
   (let $prods (member-products $members) (injective-cover? (nonfood-premise $r $prods) $prods)))

; $r is ENDO-SATISFIED by the set iff it is on a member-cycle AND its non-food premise is
; injectively regenerated by the set — the two halves of structural closure
(= (endo-satisfied? $r $members)
   (if (endo-cyclic? $r $members) (injective-covered? $r $members) False))

; --- the ENDO-COMPONENT (#2 subset-mining): the greatest subset of $fired where EVERY member is
; endo-satisfied by the subset (Ben's self-recreating subnetwork). PEELED to a fixpoint — drop
; members not endo-satisfied by the current set, repeat until stable — because dropping a feed-
; forward converter can un-cover a member that leaned on it: {R_trans} survives the first peel via
; the candidate set's several ReasonFor producers, then falls once they are peeled and it stands
; alone with one producer for a two-ReasonFor premise. ---
(= (endo-component $fired) (peel-component $fired))
(= (peel-component $S)
   (let $kept (keep-satisfied $S $S) (if (== (len $kept) (len $S)) $kept (peel-component $kept))))
(= (keep-satisfied $todo $S)
   (case $todo
         ((() ())
          ($ne (let $r (car-atom $todo)
                    (if (endo-satisfied? $r $S)
                        (cons-atom $r (keep-satisfied (cdr-atom $todo) $S))
                        (keep-satisfied (cdr-atom $todo) $S)))))))

; the ACS's member set: the closed endo-component if one exists; else the food-fed candidate
; network — a subsidized near-miss (viable/useful/recurrent but not closed). The §4.5 conditions
; are computed over THIS set: a genuine closed core IS the ACS (the food-intake rules that feed it
; stay outside); when none exists the whole viable candidate stands in so the not-closed contrast
; stays visible (classic V3's case).
(= (acs-member-set $g $fired)
   (let $comp (endo-component $fired) (if (== $comp ()) (acs-members $g $fired) $comp)))

; structurally closed iff every member is endo-satisfied (empty set ⇒ not closed); $todo iterates
; while the FULL $members set is threaded to each check — a member may be satisfied only THROUGH
; other members, so the set must not shrink during the walk
(= (all-endo-satisfied? $todo $members)
   (case $todo
         ((() True)
          ($ne (if (endo-satisfied? (car-atom $todo) $members)
                   (all-endo-satisfied? (cdr-atom $todo) $members)
                   False)))))
(= (structurally-closed? $members) (if (== $members ()) False (all-endo-satisfied? $members $members)))

; is relation $r a CONTROL motif? (declared `(control-relation R)` in &self — an internally
; generated control state: attention shift, activation, success trace, reusable template,
; learned gate, minted token). Undeclared relations are SEMANTIC (domain propositions).
(= (control-rel? $r)
   (case (collapse (match &self (control-relation $r) $r)) ((() False) ($x True))))

; the relation heads of a clause list ((Rel arg…) → Rel)
(= (clause-rels $clauses)
   (if (== $clauses ()) () (cons-atom (car-atom (car-atom $clauses)) (clause-rels (cdr-atom $clauses)))))

; the relations the closed loop REGENERATES on its cycle = the members' non-food premise
; relations (each such motif is produced by a member and consumed by a member)
(= (closure-rels $members)
   (let $prods (member-products $members) (dedup (rels-of-nonfood $members $prods))))
(= (rels-of-nonfood $members $prods)
   (case $members
         ((() ())
          ($ne (concat-lists (clause-rels (nonfood-premise (car-atom $members) $prods))
                             (rels-of-nonfood (cdr-atom $members) $prods))))))

; classify a regenerated-relation set: `control` if ALL are control motifs, `substrate` if all
; semantic, `hybrid` if it mixes the two (Ben's three closure levels)
(= (any-control? $rels)
   (case $rels ((() False) ($ne (if (control-rel? (car-atom $rels)) True (any-control? (cdr-atom $rels)))))))
(= (any-semantic? $rels)
   (case $rels ((() False) ($ne (if (control-rel? (car-atom $rels)) (any-semantic? (cdr-atom $rels)) True)))))
(= (kind-of-rels $rels)
   (if (any-control? $rels) (if (any-semantic? $rels) hybrid control) substrate))

; the closure KIND of a member set, from the motifs it REGENERATES (its members' non-food premise
; relations): `substrate` (all semantic domain motifs), `control` (all internally-generated
; control motifs), or `hybrid` (it alternates between the two); `none` if not structurally closed.
(= (closure-kind $members) (if (structurally-closed? $members) (kind-of-rels (closure-rels $members)) none))

; the closure verdict FACT, emitted ONLY when the set is genuinely closed — a food-fed /
; subsidized candidate is NOT an ACS (it fails closure), so it gets NO acs-* closure fact; its
; "subsidized" status is inferred elsewhere (metabolic surplus present + no acs-closure fact).
(= (closure-facts $A $members)
   (let $k (closure-kind $members) (if (== $k none) () (cons-atom (acs-closure $A $k) ()))))

; a display reader: the closure kind emitted for $A in &self, or `none` if $A has no acs-closure
; fact (not closed) — so a conditions checklist can show closure without the match vanishing
(= (closure-of $A)
   (let $r (collapse (match &self (acs-closure $A $c) $c)) (if (== $r ()) none (car-atom $r))))

; --- M_A (§4.5): the graph-motif SPECIES. A member rule's motif patterns are its candidate
; motifs; those on the cycle = M_A (the loop regenerates them). Food motifs
; (consumed but never produced, so off every cycle) are external and stay out. ---

; the distinct motifs the members consume or produce (candidate motif species): each member's
; reactant motif (its whole LHS) and product motif (its whole RHS)
(= (motifs-touched $members)
   (case $members
         ((() ())
          ($ne (concat-lists (cons-atom (rule-reactant (car-atom $members)) (cons-atom (rule-product (car-atom $members)) ()))
                             (motifs-touched (cdr-atom $members)))))))

; M_A: the motif species that lie on the cycle
(= (acs-motifs $g $members) (cycling-only $g (dedup (motifs-touched $members))))
(= (cycling-only $g $ms)
   (case $ms
         ((() ())
          ($ne (let $m (car-atom $ms)
                    (if (cycle-through $g $m)
                        (cons-atom $m (cycling-only $g (cdr-atom $ms)))
                        (cycling-only $g (cdr-atom $ms))))))))

; --- AUTOCATALYSIS (§4.5 cond 2): each member is enabled by a motif/token ON the cycle — a
; motif another member regenerates, or a token the ACS macro-atom mints. Holds for our
; cycle-based membership by construction, but computed independently (a real per-member check). ---
(= (any-cycling? $g $nodes)
   (case $nodes ((() False) ($ne (if (cycle-through $g (car-atom $nodes)) True (any-cycling? $g (cdr-atom $nodes)))))))
(= (member-autocat? $g $r) (any-cycling? $g (preds $g $r)))
(= (autocatalytic? $g $members)
   (if (== $members ()) False (all-autocat? $g $members)))
(= (all-autocat? $g $members)
   (case $members
         ((() True)
          ($ne (if (member-autocat? $g (car-atom $members)) (all-autocat? $g (cdr-atom $members)) False)))))

; --- per-token metabolic SURPLUS (eq 19): income under $cl − the members' token spend ---

; the per-firing $tok cost of rule $r (0 if it does not cost $tok)
(= (token-cost $r $tok)
   (case (collapse (match &self (rule-token-cost $r $tok $n) $n)) ((() 0) ($ns (car-atom $ns)))))

; $tok spent by rule $r over its firings (in run space $ws) / by a whole rule list
(= (rule-token-spend $ws $r $tok) (* (rule-firings $ws $r) (token-cost $r $tok)))
(= (members-spend $ws $rs $tok)
   (case $rs ((() 0) ($ne (+ (rule-token-spend $ws (car-atom $rs) $tok) (members-spend $ws (cdr-atom $rs) $tok))))))

; the signed surplus of the ACS members for token $tok under clamp $cl (eq 19); income is
; grounded against the run space $ws (where the derived layer lives)
(= (token-surplus $ws $members $cl $tok) (- (chamber-income $ws $cl $tok) (members-spend $ws $members $tok)))

; the distinct tokens the members cost (the components condition 3 checks)
(= (members-tokens $members)
   (dedup (filter-out skip (collapse (match &self (rule-token-cost $r $tok $n) (if (in-list? $r $members) $tok skip))))))

; --- causal influence (condition 4): a REPLAY ablation (the stronger form). Re-derive the
; chamber's answers in the isolated space $abl with the ACS members SUPPRESSED, restoring
; the snapshot fuel; if the count drops below the baseline (the certification run's
; total-answers in $ws), the loop causally PRODUCES those answers. An actual counterfactual
; re-run, not the structural "a member names an answer-queried relation" proxy. ---

; WIPE all mutable state from replay space $abl (molecules, derived layer, tvs, events, fuel,
; cycle + task markers) so it can be freshly re-materialized — leave-one-out reuses one $abl
; across many replays
(= (wipe-space $abl)
   (let* (($z1 (remove-all $abl (collapse (match $abl (sem-edge $g $i $r $a) (sem-edge $g $i $r $a)))))
          ($z2 (remove-all $abl (collapse (match $abl (sem-edge $g $i $r $a $b) (sem-edge $g $i $r $a $b)))))
          ($z3 (remove-all $abl (collapse (match $abl (sem-edge $g $i $r $a $b $c) (sem-edge $g $i $r $a $b $c)))))
          ($z4 (remove-all $abl (collapse (match $abl (sem-edge-tv $g $i $tv) (sem-edge-tv $g $i $tv)))))
          ($z5 (remove-all $abl (collapse (match $abl (event $c $s $r $k) (event $c $s $r $k)))))
          ($z6 (remove-all $abl (collapse (match $abl (fuel $O $t $n) (fuel $O $t $n)))))
          ($z7 (remove-all $abl (collapse (match $abl (cycle-now $k) (cycle-now $k)))))
          ($z8 (remove-all $abl (collapse (match $abl (cycle-task $k2 $t2) (cycle-task $k2 $t2)))))
          ($z9 (remove-all $abl (collapse (match $abl (task-now $t3) (task-now $t3))))))
     done))

; run the chamber in the isolated space $abl with the rules $skip suppressed, POSING task $t —
; the space is wiped, $t is posed (so its text arrives), snapshot fuel is restored — and return
; the resulting answer count. Posing the same task the baseline was measured under is what makes
; the two sides a pair; `all` replays every task's text at once (an untagged run).
(= (ablated-answers $abl $ch $snap $t $skip)
   (let* (($z0 (wipe-space $abl))
          ($z1 (set-task $abl $t))
          ($z2 (copy-molecules $abl))
          ($z3 (restore-snapshot $abl $snap))
          ($z4 (run-chamber-ablate $abl $ch $skip)))
     (total-answers $abl)))

; does suppressing the members in $abl drop the answer count below the $ws baseline? Both sides
; are read under the task $ws currently poses.
(= (causal-influence? $ws $abl $ch $snap $members)
   (> (total-answers $ws) (ablated-answers $abl $ch $snap (current-task $ws) $members)))

; --- RULE-LEVEL CAUSAL CODING (SC §3, per-rule do-influence): the finer, per-member breakdown
; of the ACS-level causal influence above. do-influence is measured by a LEAVE-ONE-OUT paired
; replay (SC §3.7 "rule enabled vs disabled"): baseline minted reward − reward with just that one
; member disabled. delta > 0 ⇒ the member is load-bearing (its firing changes the downstream
; reward); delta = 0 ⇒ the member is REDUNDANT / not-contributing (disabling it leaves the reward
; unchanged). The minimal ACS (§3.9 "its members have nontrivial do-influence") is then found by
; GREEDY SEQUENTIAL ablation, which the per-rule pass alone cannot settle — see `minimal-acs`.
; Metric = MINTED REWARD (chamber-income summed over the mintable tokens), so a
; member is credited for the KIND of answer it enables (a chain earns the causal-inference token
; too). This is distinct from Ben's ACS-level "not reproduced by redundant alternatives", which is
; the whole-loop causal-influence? above. ---

; the total minted reward in $ws under $cl = the income summed over every mintable token
(= (total-reward $ws $cl) (sum-token-incomes $ws $cl (mintable-tokens)))
(= (sum-token-incomes $ws $cl $toks)
   (case $toks ((() 0) ($ne (+ (chamber-income $ws $cl (car-atom $toks)) (sum-token-incomes $ws $cl (cdr-atom $toks)))))))

; --- the measurement WINDOW, in TASKS. A rule whose contribution only tells on a LATER arrival
; cannot be seen by a single-task replay at all — it would measure 0 there, which is true of that
; task and false of the loop. The fix is to widen the
; window, NOT to special-case the rule; every member is still measured identically. The replay
; re-poses exactly the task SEQUENCE the certified log served, so the ablated run does the same
; work as the run it is compared against (the doc's same-snapshot paired replay).

; the replay CAP in tasks (config `(acs-window-max n)`, default 3). Past the task where the
; ablated and unablated trajectories separate, each further task adds a constant — so a longer
; window rescales the delta without telling us anything new, while costing (members + 1) x tasks
; replays. On a log thousands of tasks long that is the whole cost and none of the information.
; The cap is also what keeps a 0 honest: it reads "no difference within n tasks", which is exactly
; what the window recorded in the fact claims. Raise it where loops take longer to pay off.
(= (window-max)
   (case (collapse (match &self (acs-window-max $n) $n)) ((() 3) ($ns (car-atom $ns)))))

; the first $n elements of $l
(= (take-n $n $l)
   (if (== $n 0) () (if (== $l ()) () (cons-atom (car-atom $l) (take-n (- $n 1) (cdr-atom $l))))))

; the TASK SEQUENCE a paired replay re-poses: the tasks the observed log served, in order, capped.
; A log with no task tags replays a single `all` task — one epoch over every text, which is what
; an untagged bare run did.
(= (replay-tasks $ws)
   (let $ts (log-tasks $ws) (if (== $ts ()) (cons-atom all ()) (take-n (window-max) $ts))))

; the certification window: how many TASKS the replay spans (at least 1)
(= (window-of $ws) (len (replay-tasks $ws)))

; ONE ablated TASK in $sp: pose it (its text arrives) -> re-derive with $skip suppressed -> read
; the reward it minted -> credit it -> decay. The crediting step is what makes a multi-task
; ablation mean anything: without income the organism cannot afford the second task, so ablated
; and unablated runs alike collapse to the first and every difference vanishes.
(= (ablate-task $sp $ch $cl $t $k $skip)
   (let* (($z0 (set-task $sp $t))
          ($z1 (refresh-pool $sp))
          ($z2 (copy-molecules $sp))
          ($z3 (set-cycle $sp $k))
          ($z4 (run-chamber-ablate $sp $ch $skip))
          ($r (total-reward $sp $cl))
          ($z5 (credit-all-questions $sp $cl)))
     $r))

; the cumulative reward of the task list $ts, one task per cycle from $k, with $skip suppressed
(= (ablate-tasks $sp $ch $cl $ts $k $skip $acc)
   (case $ts
         ((() $acc)
          ($ne (let $r (ablate-task $sp $ch $cl (car-atom $ts) $k $skip)
                    (ablate-tasks $sp $ch $cl (cdr-atom $ts) (+ $k 1) $skip (+ $acc $r)))))))

; the reward a fresh replay of task sequence $ts mints in $abl with $skip suppressed — the space
; is wiped and re-fuelled from the snapshot first, so every measurement starts from the same state
(= (windowed-reward $abl $ch $snap $cl $ts $skip)
   (let* (($z0 (wipe-space $abl))
          ($z1 (restore-snapshot $abl $snap))
          ($r (ablate-tasks $abl $ch $cl $ts 1 $skip 0)))
     $r))

; the single-shot case, kept as its own name: one replay with nothing in particular posed, so
; the whole corpus is worked at once (the plain one-run intervention)
(= (ablated-reward $abl $ch $snap $cl $skip)
   (windowed-reward $abl $ch $snap $cl (cons-atom all ()) $skip))

; the do-influence of each member over the observed window = the drop in cumulative minted reward
; when that ONE member is suppressed, against an unablated run of the SAME length; returns a list
; of (rule delta) pairs. The baseline is itself a replay, so both sides are paired.
(= (member-do-influences $ws $abl $ch $snap $cl $members)
   (let $ts (replay-tasks $ws)
        (do-inf-each $abl $ch $snap $cl $ts $members (windowed-reward $abl $ch $snap $cl $ts ()))))
(= (do-inf-each $abl $ch $snap $cl $ts $members $base)
   (case $members
         ((() ())
          ($ne (let $r (car-atom $members)
                    (cons-atom ($r (- $base (windowed-reward $abl $ch $snap $cl $ts (cons-atom $r ()))))
                               (do-inf-each $abl $ch $snap $cl $ts (cdr-atom $members) $base)))))))

; the §3.7 causal-coding facts from the (rule delta) list, each carrying the window $n it was
; measured over: one (rule-do-influence R target answer-reward n delta) + one
; (rule-redundancy R n bool) per member (redundant iff delta = 0 over that window). The window is
; part of the fact because it is part of the claim — the same rule can read 0 over one cycle and
; be load-bearing over two, and both readings are true of their own window.
(= (do-inf-facts $n $dis)
   (case $dis
         ((() ())
          ($ne (let* ((($r $d) (car-atom $dis))
                      ($red (== $d 0)))
                 (cons-atom (rule-do-influence $r target answer-reward $n $d)
                   (cons-atom (rule-redundancy $r $n $red)
                              (do-inf-facts $n (cdr-atom $dis)))))))))

; the MINIMAL ACS, by GREEDY SEQUENTIAL ablation: walk the members carrying an ACCUMULATED skip
; set — test ablating (already-dropped + this member); if the reward holds at the baseline the
; member is genuinely droppable GIVEN what is already gone, so commit it to the skip set; else
; keep it. The survivors are a set that still does the job. Leave-one-out alone CANNOT do this:
; a MUTUALLY redundant group (either member alone suffices, both together are needed) measures
; do-influence 0 on every member, and dropping them all at once leaves a set that no longer
; produces the answers. Note this yields A minimal set, not THE minimum one — which member of a
; redundant group survives depends on the walk order (inherent to greedy minimization). A member
; with `rule-redundancy True` that nonetheless survives here is exactly the signature of such a
; group. Costs one replay per member, on top of the leave-one-out pass.
; Measured over the SAME window as do-influence: on a one-cycle window this drops every rule whose
; product only pays off next cycle, so a self-priming loop would be "minimized" to a set that no
; longer closes. The window is what makes it sound, not a special case for control rules.
(= (minimal-acs $ws $abl $ch $snap $cl $members)
   (let $ts (replay-tasks $ws)
        (greedy-minimize $abl $ch $snap $cl $ts $members () (windowed-reward $abl $ch $snap $cl $ts ()))))

; walk $todo threading the committed $skip set (see minimal-acs): drop a member iff ablating it
; on top of $skip still pays the baseline reward $base
(= (greedy-minimize $abl $ch $snap $cl $ts $todo $skip $base)
   (case $todo
         ((() ())
          ($ne (let* (($r (car-atom $todo))
                      ($try (cons-atom $r $skip))
                      ($rew (windowed-reward $abl $ch $snap $cl $ts $try)))
                 (if (== $rew $base)
                     (greedy-minimize $abl $ch $snap $cl $ts (cdr-atom $todo) $try $base)
                     (cons-atom $r (greedy-minimize $abl $ch $snap $cl $ts (cdr-atom $todo) $skip $base))))))))

; --- RECURRENCE (§4.5 "sustains itself in an event log" / §6.4 P2 "recurrent" loops): a
; genuine ACS is not a one-off closed loop — it must RECUR. The unit is the TASK, not the cycle:
; what the docs measure is "recurrence of useful motifs ACROSS TASKS" (the MSC and SC metric
; lists) by a genome that "repeatedly solves variants of the same question type" (MSC §7.1), so
; a loop recurs when it turns AGAIN on newly arrived material — not when the same question is
; re-answered. The loop is recurrent iff every member fires somewhere within each of
; >= (recurrence-min) distinct tasks in $ws's log. One task is a structural CANDIDATE;
; heritability (cond 5) is the P3 upgrade.
; Distinct from STRUCTURAL recurrence — a recurrent COMPONENT in the rule-motif graph — which is
; the closure check above. Both are called "recurrent" in the docs and they are different tests:
; one is a property of the genome's shape, this one of its history. ---

; the recurrence threshold (turned in >= this many tasks = recurrent); config, default 2
(= (recurrence-min)
   (case (collapse (match &self (acs-recurrence-min $n) $n)) ((() 2) ($ns (car-atom $ns)))))

; did rule $r fire in cycle $c of $ws's event log?
(= (fired-in-cycle? $ws $r $c)
   (case (collapse (match $ws (event $c $s $r $key) yes)) ((() False) ($x True))))

; did rule $r fire in ANY cycle of task $t?
(= (fired-in-task? $ws $r $t) (fired-in-any? $ws $r (cycles-of-task $ws $t)))
(= (fired-in-any? $ws $r $cs)
   (case $cs
         ((() False)
          ($ne (if (fired-in-cycle? $ws $r (car-atom $cs)) True (fired-in-any? $ws $r (cdr-atom $cs)))))))

; did EVERY member fire within task $t (the loop turned once on that task's material)?
(= (loop-in-task? $ws $members $t)
   (case $members
         ((() True)
          ($ne (if (fired-in-task? $ws (car-atom $members) $t)
                   (loop-in-task? $ws (cdr-atom $members) $t)
                   False)))))

; the number of distinct TASKS in which the whole loop turned
(= (recurrence-count $ws $members) (count-loop-tasks $ws $members (log-tasks $ws)))
(= (count-loop-tasks $ws $members $ts)
   (case $ts
         ((() 0)
          ($ne (+ (if (loop-in-task? $ws $members (car-atom $ts)) 1 0)
                  (count-loop-tasks $ws $members (cdr-atom $ts)))))))

; recurrent iff the loop turned in >= $min distinct tasks
(= (recurrent? $ws $members $min) (>= (recurrence-count $ws $members) $min))

; --- the §2.9 verdict facts for ACS $A on the (already-built) graph $g under clamp $cl ---
(= (member-facts $A $rules)
   (if (== $rules ()) () (cons-atom (acs-member $A (car-atom $rules)) (member-facts $A (cdr-atom $rules)))))

; one acs-motif per M_A species (the cycle's motif relations) — the R_A side is member-facts
(= (motif-facts $A $motifs)
   (if (== $motifs ()) () (cons-atom (acs-motif $A (car-atom $motifs)) (motif-facts $A (cdr-atom $motifs)))))

(= (surplus-facts $A $ws $members $cl $toks)
   (case $toks
         ((() ())
          ($ne (let $t (car-atom $toks)
                    (cons-atom (acs-surplus $A $cl $t (token-surplus $ws $members $cl $t))
                               (surplus-facts $A $ws $members $cl (cdr-atom $toks))))))))

; the full §2.9 verdict list = the ACS A = (M_A, R_A) + its conditions: one acs-member per member
; of the closed component (R_A; or the food-fed candidate set when none is closed) + one acs-motif
; per motif species (M_A) + acs-closure (substrate/control/hybrid, ONLY when
; structurally closed — a subsidized candidate emits NONE) + autocatalysis (cond 1+2, structural)
; + one signed acs-surplus per costed token (cond 3) + acs-causal-influence
; (cond 4 = $ci, the replay ablation in the caller-bound space $abl, re-posing chamber $ch from
; snapshot $snap; computed ONCE here, clamp-independent) + acs-recurrent (the loop recurs across
; $ws's cycle-tagged event log — False for a single epoch, the structural-candidate case) + the
; per-member SC §3 causal coding (rule-do-influence + rule-redundancy, the leave-one-out
; breakdown of causal influence). There is NO single acs-promoted/certified summary: each condition is its own fact, conjoined by a
; consumer (a "certified ACS under $cl" = acs-closure present ∧ every acs-surplus > 0 ∧ causal ∧
; recurrent).
(= (acs-verdicts $A $g $ws $abl $ch $snap $cl)
   (let* (($members (acs-member-set $g (fired-rules $ws)))
          ($toks (members-tokens $members))
          ($ci (causal-influence? $ws $abl $ch $snap $members))
          ($rif (do-inf-facts (window-of $ws) (member-do-influences $ws $abl $ch $snap $cl $members))))
     (concat-lists (member-facts $A $members)
       (concat-lists (motif-facts $A (acs-motifs $g $members))
         (concat-lists (closure-facts $A $members)
           (cons-atom (acs-autocatalytic $A (autocatalytic? $g $members))
             (concat-lists (surplus-facts $A $ws $members $cl $toks)
               (cons-atom (acs-causal-influence $A $ci)
                 (cons-atom (acs-recurrent $A (recurrent? $ws $members (recurrence-min)))
                   $rif)))))))))

; --- the acs-scan WORKER body (worker-kind `acs-scan`): the whole certification as a §6.4
; worker. Its run space $ws is populated by a prior context-chamber worker; run-as CONSUMES
; that log (never re-deriving), builds the graph in its graph space, and condition 4 replays
; the ablation in its ablation space. The graph + ablation spaces are bound at top-level by
; the runner (a body cannot mint a `(new-space)`) and read from worker facts. Dispatched by
; `dispatch.metta`. ---

; add the ACS verdict facts (each keyed on the ACS name) to &self — the worker's output.
; add-all is set-union, so re-dispatch under the SAME clamp is idempotent; under a DIFFERENT
; clamp the new verdicts sit alongside (they are keyed on the clamp).
(= (emit-verdicts $verdicts) (add-all &self $verdicts))

; CONSUME the run space $ws a prior context-chamber worker populated (its log + derived layer +
; income; MSC §6.4 P2 "scan event logs") -> build the reaction graph in $g from that log ->
; certify under $cl (condition 4 replays the ablation in $abl from the snapshot) -> emit the
; §2.9 verdicts (the worker's output). It does NOT derive.
(= (run-as $w)
   (let* (($ws (match &self (worker-space $w $sp) $sp))
          ($g (match &self (worker-graph-space $w $gs) $gs))
          ($abl (match &self (worker-ablate-space $w $as) $as))
          ($ch (match &self (worker-chamber $w $c) $c))
          ($cl (match &self (worker-clamp $w $c2) $c2))
          ($snap (match &self (worker-snapshot $w $s) $s))
          ($A (match &self (worker-acs $w $a) $a))
          ($z3 (build-graph $g (fired-rules $ws))))
     (emit-verdicts (acs-verdicts $A $g $ws $abl $ch $snap $cl))))
