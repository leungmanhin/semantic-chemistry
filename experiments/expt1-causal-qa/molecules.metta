; Experiment 1 — MOLECULES (the parsed-text semantic graphs), pure portable facts.
; The semantic parser's output over corpus.json, adapted to IR per ../../ir/parser_adapter.md.
; Shape: (node-graph G N) scopes node N to graph G; (Member N lemma) types it; roles
; and explanatory links are binary relations (Rel Src Dst) with the relation as head;
; (node-modal N intended|prevented) marks a goal/purpose state or a blocked event. Node
; ids are globally unique.

; --- V7 (out-of-milk): antecedent cause + goal (the clamp-switch dual) ---
(node-graph V7g v7_oom)
(Member v7_oom out_of_milk)
(node-graph V7g v7_maria)
(Member v7_maria person)
(Experiencer v7_oom v7_maria)
(node-graph V7g v7_drive)
(Member v7_drive drive)
(node-graph V7g v7_store)
(Member v7_store store)
(Agent v7_drive v7_maria)
(Destination v7_drive v7_store)
(node-graph V7g v7_buy)
(Member v7_buy buy)
(node-modal v7_buy intended)
(node-graph V7g v7_carton)
(Member v7_carton carton)
(Agent v7_buy v7_maria)
(Theme v7_buy v7_carton)
(CauseOf v7_oom v7_drive)
(Motivate v7_buy v7_drive)

; --- V3 (power-spoil): two-hop mechanism chain (action events + Patient participants) ---
(node-graph V3g v3_goout)
(Member v3_goout go_out)
(node-graph V3g v3_power)
(Member v3_power power)
(Patient v3_goout v3_power)
(node-graph V3g v3_stop)
(Member v3_stop stop)
(node-graph V3g v3_fridge)
(Member v3_fridge fridge)
(Patient v3_stop v3_fridge)
(node-graph V3g v3_spoil)
(Member v3_spoil spoil)
(node-graph V3g v3_food)
(Member v3_food food)
(Patient v3_spoil v3_food)
(CauseOf v3_goout v3_stop)
(CauseOf v3_stop v3_spoil)

; --- V17 (sprinklers): prevention (negated spread bundle -> node-modal prevented) ---
