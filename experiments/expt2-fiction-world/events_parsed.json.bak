    "(: hs_name (Name harbor_station \"Harbor Station\") (STV 1.0 0.99))",
    "(: hs_type (Member harbor_station lantern_station) (STV 1.0 0.99))",
    "(: ls_genus (Inheritance lantern_station station) (STV 1.0 0.99))",
    "(: hs_on (On harbor_station cliff_path) (STV 1.0 0.99))",
    "(: hs_near (Near harbor_station sk_harbor_1) (STV 1.0 0.99))"
