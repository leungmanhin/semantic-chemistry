    "(: s4_compartment_q (QuantifierPhrase compartment label \"each\") (STV 1.0 0.99))",
    "(: s4_date_typ (Member sk_date_1 date) (STV 1.0 0.99))",
    "(: s5_potent_st (Member sk_potent_1 potent) (STV 1.0 0.99))",
