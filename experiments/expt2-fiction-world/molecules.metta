; Experiment 2 — MOLECULES, pure portable facts in §10.1 sem-graph IR: one doc, aelmere, holding one neo-davidsonian
; graph per parse unit — a world-rules sentence, a lore sentence, an event passage — with every ground fact of the
; three admitted corpora (world_rules_parses.json, lore_parsed.json, events_parsed.json), landed by exp2_adapter.py
; under the ingestion conventions of REALIGNMENT.md item 1 (each adapter-added edge names its convention in
; sem-edge-source). A graph is named by its unit; edge ids are unit-prefixed parser ids; witnesses are unit-scoped.
(sem-doc aelmere)

; --- R1.1: When a lantern burns mire-essence, the lantern produces mist-light.
(sem-graph R1_1)
(sem-graph-kind R1_1 neo-davidsonian)
(doc-graph aelmere R1_1)
(sem-edge R1_1 R1_1_mire_essence_genus Inheritance mire_essence essence)
(sem-edge-tv R1_1 R1_1_mire_essence_genus (STV 1.0 0.99))
(sem-edge R1_1 R1_1_mist_light_genus Inheritance mist_light light)
(sem-edge-tv R1_1 R1_1_mist_light_genus (STV 1.0 0.99))

